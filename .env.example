# Copy to .env and adjust. Real environment variables and command-line flags override these.

# WebSocket listen address (keep it on localhost)
BOT_ADDR=localhost:8080

# Bot name sent to the board in READY
BOT_NAME=schrodingers_mine

# Thinking time per move; keep below the board's move timeout (5s by default)
BOT_MOVE_BUDGET=4s

# Grace period for open connections on Ctrl+C / SIGTERM
BOT_SHUTDOWN_TIMEOUT=3s

# Accept WebSocket connections from any Origin. Set to false if this is ever exposed beyond localhost.
BOT_INSECURE_SKIP_VERIFY=true
